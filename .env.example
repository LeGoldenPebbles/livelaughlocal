# Copy to .env.local for dev. NEVER commit real values.

# Mongo - existing Atlas cluster, database name livelaughlocal
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/livelaughlocal?retryWrites=true&w=majority

# Public site URL (no trailing slash). Used for canonical URLs, sitemap, emails.
SITE_URL=http://localhost:3005

# Keep true until livelaughlocal.co.uk is attached to the Render service.
NOINDEX=true

# Admin panel access key (long random string). Cookie session after entry.
ADMIN_KEY=

# Secret for HMAC removal/confirm tokens (64 hex chars, independent of ADMIN_KEY)
TOKEN_SECRET=

# Stripe (same account as Spaces Please; test keys for dev)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Cloudflare R2 (S3-compatible) - bucket "livelaughlocal"
# Account ID is the same value as CLOUDFLARE_ACCOUNT_ID below; the S3 endpoint
# is just https://<account id>.r2.cloudflarestorage.com.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=livelaughlocal
R2_PUBLIC_HOST=images.livelaughlocal.co.uk
R2_S3_ENDPOINT=
# The token the R2 access key pair was minted from. R2-SCOPED ONLY: it fails
# /user/tokens/verify and cannot read or change zone settings. Anything touching
# robots.txt, cache rules, rate limiting or DNS needs a separate token with Zone
# permissions.
R2_API_TOKEN=

# Cloudflare account (zone livelaughlocal.co.uk). Used for R2 and, with a
# zone-scoped token, for cache and bot settings.
CLOUDFLARE_ACCOUNT_ID=
# Needs Zone > Zone Settings > Edit and Zone > Cache Rules > Edit to manage the
# robots.txt toggle, cache rules and rate limiting. Not set yet.
CLOUDFLARE_ZONE_API_TOKEN=

# Transactional email (Mailtrap SMTP in dev traps everything; prod token delivers)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Live Laugh Local <hello@livelaughlocal.co.uk>"

# Spaces Please public events API (Render backend direct - no Cloudflare in the way)
SP_EVENTS_API=https://eventwebsite-rups.onrender.com
